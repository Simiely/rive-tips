{
  "version": "2.3.2",
  "name": "rive-tips",
  "include": [
    "README.md",
    "AGENTS.md",
    "DEVELOPMENT.md",
    "CHANGELOG.md",
    "docs/**",
    "skills/**/SKILL.md",
    "skills/**/references/*.md"
  ],
  "context_files": ["AGENTS.md"],
  "exempt_basenames": ["README.md", "DEVELOPMENT.md", "CHANGELOG.md"],
  "slugger": "github",
  "summary_policy": "off",
  "skills": {
    "glob": "skills/**/SKILL.md",
    "schema": "schema/skills.schema.json",
    "name_matches_dir": true,
    "min_description": 40
  },
  "link_only_files": ["docs/**", "skills/**/references/*.md"],
  "types": ["tutorial", "how-to", "reference", "explanation"],
  "kinds": ["standard", "decision", "index", "note", "glossary", "report", "pitfall"],
  "statuses": ["draft", "active", "resolved", "superseded", "archived"],
  "tiers": ["normal", "critical"],
  "confidences": ["low", "medium", "high"],
  "topics": ["rive", "mcp", "cli", "effects", "delivery", "troubleshooting", "governance"],
  "relations": {
    "depends-on": {
      "direction": "directed",
      "inverse": "depended-on-by",
      "transitive": false
    },
    "extends": {
      "direction": "directed",
      "inverse": "extended-by",
      "transitive": true
    },
    "spawned-from": {
      "direction": "directed",
      "inverse": "spawned",
      "transitive": false
    },
    "supersedes": {
      "direction": "directed",
      "inverse": "superseded-by",
      "transitive": false
    },
    "contradicts": {
      "direction": "symmetric",
      "inverse": null,
      "transitive": false
    },
    "see-also": {
      "direction": "symmetric",
      "inverse": null,
      "transitive": false
    }
  },
  "review_days": {
    "normal": 365,
    "critical": 90
  },
  "entry_files": [],
  "generated_files": [],
  "ignore": [
    ".github/**",
    "tools/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/__pycache__/**"
  ]
}
